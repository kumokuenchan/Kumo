{
  "name": "mysql-database-tool",
  "version": "0.1.0",
  "description": "MySQL Database Management Tool - A comprehensive, cross-platform database management application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:electron": "concurrently \"npm run dev\" \"npm run dev:server\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:electron": "npm run build && electron-builder",
    "build:electron:win": "npm run build && electron-builder --win",
    "build:electron:mac": "npm run build && electron-builder --mac",
    "build:electron:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"electron/**/*.js\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist release",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:visual": "playwright test visual-regression.spec.ts",
    "test:accessibility": "playwright test accessibility.spec.ts",
    "test:api": "playwright test api-tester.spec.ts",
    "test:query": "playwright test query-editor.spec.ts",
    "test:schema": "playwright test schema-browser.spec.ts",
    "test:data": "playwright test data-viewer.spec.ts",
    "test:mongo": "playwright test mongodb.spec.ts",
    "test:performance": "playwright test performance.spec.ts",
    "test:connections": "playwright test connections.spec.ts",
    "test:smoke": "playwright test main-app.spec.ts",
    "test:report": "playwright show-report",
    "test:install": "playwright install --with-deps",
    "codegen": "playwright codegen localhost:5173",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest --coverage",
    "test:unit:coverage:components": "vitest run src/test/components/ --coverage",
    "test:unit:components": "vitest run src/test/components/",
    "test:unit:components:ui": "vitest src/test/components/ --ui",
    "test:unit:components:watch": "vitest src/test/components/ --watch",
    "test:unit:components:coverage": "vitest run src/test/components/ --coverage",
    "test:unit:report": "vitest run --reporter=verbose",
    "test:unit:json-report": "vitest run --reporter=json --outputFile=coverage/unit-tests.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.62.14",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@uiw/react-json-view": "^2.0.0-alpha.39",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.8.6",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.3.1",
    "framer-motion": "^12.23.24",
    "js-yaml": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.552.0",
    "mermaid": "^11.12.1",
    "mongodb": "^6.12.0",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql-formatter": "^15.6.10",
    "ssh2": "^1.17.0",
    "swagger-ui-react": "^5.30.2",
    "uuid": "^11.0.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.17",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.0.8",
    "wait-on": "^8.0.1"
  },
  "main": "electron/main.cjs",
  "author": "MySQL Database Tool Team",
  "license": "MIT"
}
