# Server Configuration
PORT=3001

# Application Mode (web | electron)
APP_MODE=web

# Security
SESSION_SECRET=your-secret-key-here

# Development
NODE_ENV=development

# AI Model Configuration for Text-to-SQL
# Options: qwen (default), claude, fallback
AI_MODEL=qwen

# Qwen 2.5 API Configuration (Default - Fast & Accurate)
# Get API key from: https://dashscope.aliyun.com/ or use OpenRouter
# Using OpenRouter (recommended): https://openrouter.ai/
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_URL=https://openrouter.ai/api/v1

# Claude API Configuration (Optional - Premium option)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenRouter API Key (if using OpenRouter for Qwen)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google OAuth Configuration for AWS Authentication
# Get your Client ID from Google Cloud Console -> APIs & Services -> Credentials
# Create OAuth 2.0 Client ID for Web Application
# Add authorized redirect URI: http://localhost:5174/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: Google OAuth Client Secret (for server-side token exchange)
# This is used by the backend server for token exchange
GOOGLE_CLIENT_SECRET=your_google_client_secret_here